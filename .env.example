# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — the service will not start without these.
# ═══════════════════════════════════════════════════════════════════════════

# Google Cloud Vision (OCR). Read from the environment only — never
# hardcoded, never baked into the Docker image. Required for
# /api/v1/prescriptions/process and /extract; the app still boots without it
# (only those two routes fail at request time), unlike DATABASE_URL below.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# This service's OWN Postgres instance (medicine catalog) — deliberately
# independent of any other application's database (never Aurora / any other
# app's DB — see README "Medicine catalog architecture"). No hardcoded
# fallback of any kind: unset or unreachable both fail startup loudly,
# mirroring prod_app's own backend/src/db/pool.ts.
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Local dev: `docker compose up -d db` starts one matching the example below.
# Production (e.g. Railway's own Postgres plugin): use the connection string
# it provides, normally including `?sslmode=require`.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prescription_intelligence

# ═══════════════════════════════════════════════════════════════════════════
# Optional — sane defaults shown; usually no need to change.
# ═══════════════════════════════════════════════════════════════════════════

# CORS — comma-separated allowed origins, or "*" for all (default)
CORS_ORIGINS=*

# Upload limits — protect against unbounded resource use from one request
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=20

DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# Medicine matching tuning (sane defaults shown; usually no need to change)
MEDICINE_MATCH_THRESHOLD=82.0
MEDICINE_AMBIGUITY_MARGIN=4.0
MEDICINE_CANDIDATE_LIMIT=8
MEDICINE_MIN_TRIGRAM_SIMILARITY=0.2

# ─────────────────────────────────────────────────────────────────────────
# ABDM Drug Registry sync — OPTIONAL, disabled by default. Not required for
# local development; the catalog works fully off the legacy-seeded data
# without any of this set. See README "ABDM Drug Registry integration" for
# current status (the client is a documented extension point, not yet wired
# up against a verified API contract) and where to add real credentials.
# ─────────────────────────────────────────────────────────────────────────
ABDM_SYNC_ENABLED=false
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# RxNorm sync — OPTIONAL, disabled by default. Free, public, UNAUTHENTICATED
# API (no signup) — verified reachable. Generic/ingredient-name backbone
# ONLY (US-centric): does NOT cover Indian brands (Dolo, Crocin, ...). See
# README "RxNorm sync" for details.
# ─────────────────────────────────────────────────────────────────────────
RXNORM_SYNC_ENABLED=false
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
RXNORM_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────
# Enervara /extract adapter — POST /api/v1/prescriptions/extract
# Service-to-service endpoint for Enervara's HttpPrescriptionProcessingService
# (RX_PROCESSING_PROVIDER=http). Does not affect /api/v1/prescriptions/process.
#
# RX_PROCESSING_API_KEY: SAME name/value as Enervara's own env var of the
# same name — copy the same secret into both sides. Optional: if unset here,
# /extract runs unauthenticated (fine for local dev; a startup log warns
# loudly so this is never silently the case in a real deployment).
# ─────────────────────────────────────────────────────────────────────────
RX_PROCESSING_API_KEY=
EXTRACT_DOWNLOAD_TIMEOUT_SECONDS=30
